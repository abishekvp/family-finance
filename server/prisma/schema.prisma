generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; the rhel target is what Vercel's Node serverless runtime needs.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum AccountType {
  CASH
  BANK
  SAVINGS
  CREDIT_CARD
  DEBIT_CARD
  INVESTMENT
  LOAN
  // A friend or relative you lend to or borrow from. Its balance is what they owe you (positive)
  // or what you owe them (negative); money moves to and from it as transfers, never income/expense.
  PERSON
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CLEARED
}

// Whether an admin has let a transaction count. Only APPROVED ones move balances, budgets and totals.
enum ApprovalStatus {
  APPROVED
  PENDING
  REJECTED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum OAuthProvider {
  GOOGLE
  MICROSOFT
}

enum VerificationPurpose {
  PASSWORD_RESET
  EMAIL_CHANGE_CURRENT
  EMAIL_CHANGE_NEW
}

enum ChallengePurpose {
  PASSKEY_REGISTER
  PASSKEY_AUTH
  OAUTH_EXCHANGE
}

enum BudgetPeriod {
  MONTHLY
  WEEKLY
  ANNUAL
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  // Null for accounts created through Google/Microsoft that never set a password.
  passwordHash    String?
  // Display name, kept in sync as "firstName lastName" so existing consumers keep working.
  name            String
  firstName       String    @default("")
  lastName        String    @default("")
  avatarUrl       String?
  emailVerifiedAt DateTime?
  // Cross-device UI preferences (landing view, week start, carry-over), shared by web and mobile.
  preferences     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships          FamilyMembership[]
  ownedAccounts        Account[]              @relation("AccountOwner")
  ownedCategories      Category[]             @relation("CategoryOwner")
  transactions         Transaction[]          @relation("TransactionActor")
  reviewedTransactions Transaction[]          @relation("TransactionReviewer")
  ownedBudgets         Budget[]               @relation("BudgetOwner")
  goalContributions    GoalContribution[]
  auditLogs            AuditLog[]
  refreshTokens        RefreshToken[]
  sentInvites          Invite[]               @relation("InviteSender")
  oauthIdentities      OAuthIdentity[]
  passkeys             Passkey[]
  verificationCodes    VerificationCode[]
  vault                UserVault?
  familyKeys           FamilyKey[]
  recurring            RecurringTransaction[] @relation("RecurringOwner")
}

model OAuthIdentity {
  id        String        @id @default(cuid())
  userId    String
  provider  OAuthProvider
  subject   String
  email     String?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String?
  backedUp     Boolean   @default(false)
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Short-lived server-side state for WebAuthn ceremonies and one-time OAuth exchange codes —
// kept in the database because the API runs as stateless serverless functions.
model AuthChallenge {
  id        String           @id @default(cuid())
  userId    String?
  purpose   ChallengePurpose
  challenge String           @unique
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([expiresAt])
}

// Emailed one-time codes (password reset, email change). Only a hash of the code is stored.
model VerificationCode {
  id         String              @id @default(cuid())
  userId     String?
  email      String
  purpose    VerificationPurpose
  codeHash   String
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId, purpose])
}

// Zero-knowledge vault. The server only ever sees the KDF parameters, the public key, and the
// private key encrypted under a key derived from the user's master password (never sent here).
model UserVault {
  userId              String   @id
  kdfSalt             String
  kdfIterations       Int
  publicKey           String
  encryptedPrivateKey String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A family's data key, sealed to one member's vault public key.
model FamilyKey {
  id         String   @id @default(cuid())
  familyId   String
  userId     String
  wrappedKey String
  createdAt  DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Family {
  id                String   @id @default(cuid())
  name              String
  currency          String   @default("USD")
  // When on, transaction payee/notes are stored as client-side ciphertext (see FamilyKey).
  encryptionEnabled Boolean  @default(false)
  // When on, transactions recorded by anyone but an admin wait for an admin's approval before they count.
  requireApproval   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  memberships  FamilyMembership[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  goals        Goal[]
  invites      Invite[]
  auditLogs    AuditLog[]
  familyKeys   FamilyKey[]
  recurring    RecurringTransaction[]
}

model FamilyMembership {
  id       String   @id @default(cuid())
  userId   String
  familyId String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId])
}

model Invite {
  id          String       @id @default(cuid())
  familyId    String
  email       String
  token       String       @unique
  role        Role         @default(MEMBER)
  status      InviteStatus @default(PENDING)
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([familyId])
}

model Account {
  id                String      @id @default(cuid())
  familyId          String
  ownerId           String?
  name              String
  type              AccountType
  currency          String      @default("USD")
  openingBalance    Decimal     @default(0) @db.Decimal(14, 2)
  currentBalance    Decimal     @default(0) @db.Decimal(14, 2)
  creditLimit       Decimal?    @db.Decimal(14, 2)
  interestRate      Decimal?    @db.Decimal(6, 3)
  color             String?
  icon              String?
  sortOrder         Int         @default(0)
  isArchived        Boolean     @default(false)
  includeInNetWorth Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  family            Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner             User?                  @relation("AccountOwner", fields: [ownerId], references: [id])
  transactions      Transaction[]          @relation("TransactionAccount")
  incomingTransfers Transaction[]          @relation("TransactionTransferTo")
  goals             Goal[]
  recurring         RecurringTransaction[]

  @@index([familyId])
  @@index([ownerId])
}

model Category {
  id         String       @id @default(cuid())
  familyId   String
  ownerId    String?
  parentId   String?
  name       String
  type       CategoryType
  color      String       @default("#6366F1")
  icon       String       @default("tag")
  sortOrder  Int          @default(0)
  isArchived Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  family       Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner        User?                  @relation("CategoryOwner", fields: [ownerId], references: [id])
  parent       Category?              @relation("CategoryChildren", fields: [parentId], references: [id])
  children     Category[]             @relation("CategoryChildren")
  transactions Transaction[]
  budgets      Budget[]
  recurring    RecurringTransaction[]

  @@index([familyId])
  @@index([parentId])
}

model Transaction {
  id                  String            @id @default(cuid())
  familyId            String
  accountId           String
  transferToAccountId String?
  categoryId          String?
  userId              String
  type                TransactionType
  status              TransactionStatus @default(CLEARED)
  amount              Decimal           @db.Decimal(14, 2)
  date                DateTime
  payee               String?
  notes               String?
  tags                String[]          @default([])
  // When money lent to or borrowed from a person (a transfer to/from a PERSON account) is expected back.
  dueDate             DateTime?
  // The repeating payment this was recorded from, if any.
  recurringId         String?
  // A return of money lent or borrowed: the lend/borrow entry it pays back. Unlinked returns are
  // matched to the oldest open loans with that person.
  repaysId            String?
  // The expense a refund reverses (e.g. a subscription charge that came back). Both this entry and
  // the expense it refunds are left out of spending and income totals — the payment they cancel out
  // counts as never having happened — while the account balance (both legs really happened) isn't.
  refundsId           String?
  // Saved right away either way; only APPROVED entries count (see Family.requireApproval).
  approvalStatus      ApprovalStatus    @default(APPROVED)
  reviewedById        String?
  reviewedAt          DateTime?
  isDeleted           Boolean           @default(false)
  deletedAt           DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  family            Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  reviewedBy        User?                 @relation("TransactionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  account           Account               @relation("TransactionAccount", fields: [accountId], references: [id])
  transferToAccount Account?              @relation("TransactionTransferTo", fields: [transferToAccountId], references: [id])
  category          Category?             @relation(fields: [categoryId], references: [id])
  user              User                  @relation("TransactionActor", fields: [userId], references: [id])
  recurring         RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  repays            Transaction?          @relation("LoanRepayments", fields: [repaysId], references: [id], onDelete: SetNull)
  repayments        Transaction[]         @relation("LoanRepayments")
  refunds           Transaction?          @relation("TransactionRefund", fields: [refundsId], references: [id], onDelete: SetNull)
  refundedBy        Transaction[]         @relation("TransactionRefund")

  @@index([familyId, date])
  @@index([familyId, approvalStatus])
  // Delta sync reads a family's changes in updatedAt order.
  @@index([familyId, updatedAt])
  @@index([recurringId])
  @@index([repaysId])
  @@index([refundsId])
  @@index([accountId])
  @@index([categoryId])
}

model Budget {
  id         String       @id @default(cuid())
  familyId   String
  ownerId    String?
  categoryId String
  // Shown instead of the category's name when set (e.g. "Groceries & milk").
  name       String?
  period     BudgetPeriod @default(MONTHLY)
  amount     Decimal      @db.Decimal(14, 2)
  month      Int?
  year       Int
  rollover   Boolean      @default(false)
  // Carried into each new month (or year, for ANNUAL) when it starts.
  repeats    Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner    User?    @relation("BudgetOwner", fields: [ownerId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([categoryId, ownerId, year, month])
  @@index([familyId])
}

// A payment that repeats — a salary, rent, a subscription. Each occurrence is recorded as a real
// transaction once its day arrives (see POST /recurring/run), so it counts in balances and budgets.
model RecurringTransaction {
  id          String             @id @default(cuid())
  familyId    String
  userId      String
  accountId   String
  categoryId  String?
  type        TransactionType
  amount      Decimal            @db.Decimal(14, 2)
  // Client-side ciphertext when the family uses end-to-end encryption, like a transaction's.
  payee       String?
  notes       String?
  frequency   RecurringFrequency
  // Calendar day of the first occurrence; monthly and yearly ones keep its day of the month.
  startDate   DateTime           @db.Date
  endDate     DateTime?          @db.Date
  // Occurrences already recorded; the next is occurrence number `postedCount` from startDate.
  postedCount Int                @default(0)
  nextDate    DateTime           @db.Date
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user         User          @relation("RecurringOwner", fields: [userId], references: [id])
  account      Account       @relation(fields: [accountId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@index([familyId, nextDate])
}

model Goal {
  id           String    @id @default(cuid())
  familyId     String
  ownerId      String?
  accountId    String?
  name         String
  targetAmount Decimal   @db.Decimal(14, 2)
  targetDate   DateTime?
  isCompleted  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  family        Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  account       Account?           @relation(fields: [accountId], references: [id])
  contributions GoalContribution[]

  @@index([familyId])
}

model GoalContribution {
  id            String   @id @default(cuid())
  goalId        String
  userId        String
  amount        Decimal  @db.Decimal(14, 2)
  contributedAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([goalId])
}

model AuditLog {
  id         String   @id @default(cuid())
  familyId   String
  actorId    String
  entityType String
  entityId   String
  action     String
  diff       Json?
  createdAt  DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id])

  @@index([familyId, createdAt])
}
