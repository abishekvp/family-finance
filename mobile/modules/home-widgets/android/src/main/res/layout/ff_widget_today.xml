<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/ff_widget_bg"
  android:orientation="vertical"
  android:paddingStart="14dp"
  android:paddingTop="12dp"
  android:paddingEnd="14dp"
  android:paddingBottom="6dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
      android:id="@+id/ff_today_header"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ff_widget_today_title"
        android:textColor="@color/ff_widget_ink"
        android:textSize="15sp"
        android:textStyle="bold" />

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/ff_today_date"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:singleLine="true"
          android:textColor="@color/ff_widget_ink_subtle"
          android:textSize="12sp" />

        <TextView
          android:id="@+id/ff_today_count"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="4dp"
          android:singleLine="true"
          android:textColor="@color/ff_widget_ink_subtle"
          android:textSize="12sp"
          android:visibility="gone" />
      </LinearLayout>
    </LinearLayout>

    <TextView
      android:id="@+id/ff_today_add"
      android:layout_width="34dp"
      android:layout_height="34dp"
      android:background="@drawable/ff_widget_add_bg"
      android:contentDescription="@string/ff_widget_add_transaction"
      android:gravity="center"
      android:includeFontPadding="false"
      android:text="+"
      android:textColor="@color/ff_widget_brand"
      android:textSize="22sp"
      android:textStyle="bold" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/ff_today_totals"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/ff_widget_totals_bg"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ff_widget_spent"
        android:textAllCaps="true"
        android:textColor="@color/ff_widget_ink_subtle"
        android:textSize="10sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/ff_today_spent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="—"
        android:textColor="@color/ff_widget_expense"
        android:textSize="16sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ff_widget_income"
        android:textAllCaps="true"
        android:textColor="@color/ff_widget_ink_subtle"
        android:textSize="10sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/ff_today_income"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="—"
        android:textColor="@color/ff_widget_income"
        android:textSize="16sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="4dp"
    android:layout_weight="1">

    <ListView
      android:id="@+id/ff_today_list"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:divider="@color/ff_widget_line"
      android:dividerHeight="1dp"
      android:scrollbars="none" />

    <TextView
      android:id="@+id/ff_today_empty"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:padding="8dp"
      android:text="@string/ff_widget_empty_today"
      android:textColor="@color/ff_widget_ink_subtle"
      android:textSize="13sp" />
  </FrameLayout>
</LinearLayout>
