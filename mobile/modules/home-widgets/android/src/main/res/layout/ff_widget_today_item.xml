<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/ff_item_root"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingTop="8dp"
  android:paddingBottom="8dp">

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/ff_item_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:fontFamily="sans-serif-medium"
      android:singleLine="true"
      android:textColor="@color/ff_widget_ink"
      android:textSize="14sp" />

    <TextView
      android:id="@+id/ff_item_subtitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:singleLine="true"
      android:textColor="@color/ff_widget_ink_subtle"
      android:textSize="12sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/ff_item_amount_expense"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:singleLine="true"
    android:textColor="@color/ff_widget_expense"
    android:textSize="14sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/ff_item_amount_income"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:singleLine="true"
    android:textColor="@color/ff_widget_income"
    android:textSize="14sp"
    android:textStyle="bold"
    android:visibility="gone" />

  <TextView
    android:id="@+id/ff_item_amount_transfer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:singleLine="true"
    android:textColor="@color/ff_widget_ink_muted"
    android:textSize="14sp"
    android:textStyle="bold"
    android:visibility="gone" />
</LinearLayout>
