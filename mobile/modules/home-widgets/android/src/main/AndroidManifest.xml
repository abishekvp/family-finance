<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Merged into the app manifest. `android/` is generated, so the widgets have to be declared here. -->
  <application>
    <receiver
      android:name="expo.modules.homewidgets.QuickAddWidgetProvider"
      android:exported="false"
      android:label="@string/ff_widget_quick_add_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/ff_widget_quick_add_info" />
    </receiver>

    <receiver
      android:name="expo.modules.homewidgets.TodayWidgetProvider"
      android:exported="false"
      android:label="@string/ff_widget_today_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <!-- "Today" moves when the clock or time zone does. -->
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/ff_widget_today_info" />
    </receiver>

    <service
      android:name="expo.modules.homewidgets.TodayWidgetService"
      android:exported="false"
      android:permission="android.permission.BIND_REMOTEVIEWS" />
  </application>
</manifest>
