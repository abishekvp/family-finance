{
  "name": "family-finance",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --workspace client",
    "build:server": "npm run build --workspace server",
    "build:android": "cd mobile && npm run build:android",
    "build:mobile": "npm run build:android",
    "build": "npm run build:client && npm run build:server",
    "build:all": "node scripts/release.mjs",
    "start": "npm run start --workspace server",
    "prisma:generate": "npm run prisma:generate --workspace server",
    "prisma:migrate": "npm run prisma:migrate --workspace server",
    "prisma:deploy": "npm run prisma:deploy --workspace server",
    "prisma:studio": "npm run prisma:studio --workspace server",
    "build:play": "node scripts/release.mjs --play"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "sharp": "^0.34.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true
  }
}
