{
  "buildCommand": "npm run build:client && npm run prisma:generate",
  "outputDirectory": "client/dist",
  "installCommand": "npm install --include=dev",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}