# Copy to server/.env for local development
DATABASE_URL="postgresql://family_finance_app:CHANGE_ME@localhost:5432/family_finance"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
PORT=5000
NODE_ENV=development

# Vercel Blob Storage — hosts the built Android APK so the web "Get the app"
# page and the in-app update checker always serve the latest build. Create a
# blob store at https://vercel.com/dashboard/stores and copy its credentials
# here. `mobile/scripts/upload-apk.js` uploads to it automatically; the server
# only needs ASSET_STORE_ID to derive the public download URL.
ASSET_STORE_ID="store_xxxxxxxxxxxx"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Public origin of the web app. Used for OAuth redirect URIs and as the WebAuthn (passkey) RP ID.
PUBLIC_APP_URL="http://localhost:5173"

# Email delivery for "forgot password" and "change email" codes. Without SMTP_HOST, development
# prints the codes to the server log and production returns a 503.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Family Finance <no-reply@example.com>"

# Sign in with Google — OAuth client type "Web application",
# redirect URI: ${PUBLIC_APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Sign in with Microsoft — Entra ID app registration (Web platform),
# redirect URI: ${PUBLIC_APP_URL}/api/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"

# Passkeys in the Android app: SHA-256 fingerprint(s) of the APK signing cert (comma-separated,
# colon hex as printed by keytool). Served at /.well-known/assetlinks.json.
ANDROID_CERT_SHA256=""
