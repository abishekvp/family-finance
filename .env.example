# Copy to server/.env for local development
DATABASE_URL="postgresql://family_finance_app:CHANGE_ME@localhost:5432/family_finance"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
PORT=5000
NODE_ENV=development

# Vercel Blob Storage — hosts the built Android APK so the web "Get the app"
# page and the in-app update checker always serve the latest build. Create a
# blob store at https://vercel.com/dashboard/stores and copy its credentials
# here. `mobile/scripts/upload-apk.js` uploads to it automatically; the server
# only needs ASSET_STORE_ID to derive the public download URL.
ASSET_STORE_ID="store_xxxxxxxxxxxx"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
